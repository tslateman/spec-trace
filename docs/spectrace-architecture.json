  "cards": [
    {
      "dot": "cyan",
      "title": "Evidence in",
      "items": [
        "parse_specs reads specs/ and corpus/ Markdown into a treebeard requirement tree",
        "import_results ingests JUnit XML; the pytest plugin emits links.json",
        "Instrumented apps and observability platforms POST to /api/v1/"
      ]
    },
    {
      "dot": "emerald",
      "title": "One shared database",
      "items": [
        "The CLI bootstraps Django in-process and writes to Postgres directly",
        "Fly.io serves the API and admin against the same session pooler",
        "DATABASE_URL falls back to local SQLite when unset"
      ]
    },
    {
      "dot": "violet",
      "title": "Answers out",
      "items": [
        "post_impact_comment writes change-impact analysis back to the pull request",
        "report_to_linear and the flow handler reach Linear over GraphQL",
        "The matrix and high-risk dashboards answer what a change puts at risk"
      ]
    }
  ]
