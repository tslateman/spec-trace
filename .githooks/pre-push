#!/usr/bin/env bash
# Report commits missing from CHANGELOG.md's Unreleased section.
#
# CI regenerates and commits the section on main, so this warns rather than
# rejects. `just push` does the same work locally and keeps the bot out of
# the history.
#
# Install: git config core.hooksPath .githooks

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
if ! python3 "$repo_root/scripts/changelog.py" check; then
  echo
  echo "Pushing anyway — CI commits the update. Run \`just push\` to do it here."
fi
exit 0
